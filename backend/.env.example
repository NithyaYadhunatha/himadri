# InfraMind — Environment Configuration
# Copy this file to .env and fill in values before running

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://infra:infra@localhost:5432/inframind

# ─── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://192.168.1.11:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=inframind

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API Security ─────────────────────────────────────────────────────────────
# Bearer token required for all non-agent API routes (and the MCP endpoint below)
API_SECRET_KEY=changeme_for_hackathon

# ─── MCP Server (for n8n AI Agent / MCP Client node) ──────────────────────────
# Exposes a curated set of read/report/simulation endpoints at POST/GET /mcp
# (Streamable HTTP transport). Same Bearer token as above is required.
MCP_ENABLED=true

# ─── Agent Behaviour ──────────────────────────────────────────────────────────
# How often agents send heartbeats (seconds)
HEARTBEAT_INTERVAL=10

# How long without a heartbeat before a node is marked offline (seconds).
# The demo/static seed (scripts/seed_waters_demo.py) writes nodes once with
# no per-node agent heartbeating afterward, so this needs to comfortably
# outlast a demo session or the offline-detection background task
# (backend/main.py) marks every seeded node offline within minutes. Lower
# this back down (e.g. 60) once real per-node agents are heartbeating
# continuously.
OFFLINE_TIMEOUT_SECONDS=86400
OPENAI_API_KEY=
# ─── Backend ──────────────────────────────────────────────────────────────────
# Set to "development" or "production"
ENVIRONMENT=development
LOG_LEVEL=INFO
