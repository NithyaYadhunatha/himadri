# Optional: keep Clerk login/RBAC available when the frontend Mongo service is
# offline. ADMIN_EMAILS and Clerk invitations keep their assigned roles;
# otherwise authenticated users receive read-only HQ_NCPOR/AUDITOR access.
# CLERK_METADATA_AUTH_FALLBACK=true

# --- Bharati 3D twin: scientific equipment ---
# Simulated equipment telemetry (magnetometers, radiation, power…) for demos.
# Off by default: equipment without a real feed shows "Data unavailable".
# Every simulated value is labelled SIMULATED. The console's DEMO mode also enables it.
# NEXT_PUBLIC_ENABLE_EQUIPMENT_SIMULATION=true
